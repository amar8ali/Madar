---
import type { Lang } from '../i18n/config';
import type { ToolCategoryDefinition } from '../data/types';
import { localizePath } from '../i18n/utils';

interface Props {
  lang: Lang;
  category: ToolCategoryDefinition;
}

const { lang, category } = Astro.props;

// As of Phase 2, category index pages are real
// (/[lang]/tools/[category]/), generated by
// src/pages/[lang]/tools/[category]/index.astro from this same
// categories dataset — so this card can safely link to it.
const href = localizePath(lang, `/tools/${category.slug}`);
---

<a href={href} class="category-card card card-interactive">
  <span class="category-icon" aria-hidden="true" data-icon={category.icon}></span>
  <h3>{category.title[lang]}</h3>
  <p>{category.description[lang]}</p>
</a>

<style>
  .category-card {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    text-align: start;
  }

  .category-icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--color-primary) 14%, transparent);
    margin-bottom: var(--space-2);
    position: relative;
  }

  .category-icon::before {
    content: '';
    position: absolute;
    inset: 11px;
    background: var(--color-primary);
    border-radius: 4px;
  }

  .category-card h3 {
    font-size: 0.9375rem;
  }

  .category-card p {
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    line-height: 1.5;
  }
</style>
