---
import type { Lang } from '../i18n/config';
import { useTranslations, localizePath } from '../i18n/utils';
import Breadcrumb from './Breadcrumb.astro';
import RoadmapCard from './RoadmapCard.astro';
import { roadmaps } from '../data/roadmaps';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const breadcrumbItems = [
  { label: t.toolPage.home, href: localizePath(lang, '/') },
  { label: t.roadmapPage.roadmaps },
];
---

<article class="roadmap-index">
  <div class="container">
    <Breadcrumb items={breadcrumbItems} />

    <header class="roadmap-index-header">
      <h1>{t.roadmapPage.allRoadmaps}</h1>
      <p>{t.sections.roadmapsSub}</p>
    </header>

    <div class="grid grid-roadmaps">
      {roadmaps.map((roadmap) => <RoadmapCard lang={lang} roadmap={roadmap} />)}
    </div>
  </div>
</article>

<style>
  .roadmap-index {
    padding-block: var(--space-6) var(--space-9);
  }

  .roadmap-index-header {
    max-width: 640px;
    margin-bottom: var(--space-7);
  }

  .roadmap-index-header h1 {
    font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem);
  }

  .roadmap-index-header p {
    margin-top: var(--space-3);
    color: var(--color-text-muted);
    font-size: 1.0625rem;
  }
</style>
