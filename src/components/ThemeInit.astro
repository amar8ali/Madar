---
import { THEME_STORAGE_KEY } from '../i18n/config';
---

{/*
  Inline, render-blocking script that sets data-theme on <html> BEFORE
  first paint. This must stay a plain inline script (not a module, not
  deferred) — anything async here causes a visible flash of the wrong
  theme on load. It only ever reads localStorage/matchMedia and writes
  one attribute; no analytics, no network calls.

  data-theme is ALWAYS set explicitly (falling back to the system
  preference when nothing is stored) so every other component — the
  toggle icon, any theme-aware styling — can key off a single explicit
  attribute instead of also having to duplicate the prefers-color-scheme
  fallback logic themselves.
*/}
<script is:inline define:vars={{ THEME_STORAGE_KEY }}>
  (function () {
    var theme = 'light';
    try {
      var stored = localStorage.getItem(THEME_STORAGE_KEY);
      if (stored === 'light' || stored === 'dark') {
        theme = stored;
      } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
        theme = 'dark';
      }
    } catch (e) {
      /* localStorage unavailable (private mode, etc.) — fall back to
         whatever `theme` already resolved to above */
    }
    document.documentElement.setAttribute('data-theme', theme);
  })();
</script>
