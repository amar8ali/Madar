---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ToolCategoryPage from '../../../../components/ToolCategoryPage.astro';
import { categories } from '../../../../data/categories';
import type { ToolCategoryDefinition } from '../../../../data/types';

interface Props {
  category: ToolCategoryDefinition;
}

export function getStaticPaths() {
  // One page per category, generated from data/categories.ts — this is
  // the same pattern as the tool route: adding a category to that
  // dataset is enough to get a working (if initially empty) page here.
  return categories.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const pageTitle = category.title.ar;
const pageDescription = category.description.ar;
---

<BaseLayout lang="ar" title={pageTitle} description={pageDescription}>
  <ToolCategoryPage lang="ar" category={category} />
</BaseLayout>
